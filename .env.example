# Paid OpenAI API path:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Local OpenAI-compatible LLM path for demos. OPENAI_API_KEY is optional here;
# the app supplies a dummy local key when OPENAI_BASE_URL is set.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=your-local-model

# Some local servers do not support the OpenAI response_format JSON-mode option.
# Keep this enabled when possible; disable only if your local server rejects it.
# OPENAI_JSON_MODE=1

# For local reasoning/thinking models, ask the server to suppress hidden
# reasoning output so JSON parsing stays clean when supported.
# OPENAI_REASONING_EFFORT=none

# Skip PlusCal/TLC only for quick UI smoke tests. Leave enabled when demoing TLC.
# SAFETY_RUN_TLC=1

# Set these when serving the local app through your website, a tunnel, or proxy.
# PUBLIC_DEMO_HOSTNAME=demo.example.com
# CLOUDFLARE_HOSTNAME=live-demo.example.com
# ALLOWED_HOSTS=demo.example.com,live-demo.example.com,127.0.0.1,localhost
