{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tla-finance.local/schemas/phase3b-corpus-0.2.1.json",
  "title": "TLA-Finance Phase 3B execution-grounded corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_version", "fsir_version", "semantic_projection_version", "policy_profiles", "backend_fixtures", "cases"],
  "properties": {
    "corpus_version": {"const": "phase3b-0.2.1"},
    "fsir_version": {"const": "fsir-0.1"},
    "semantic_projection_version": {"const": "corpus-semantic-projection-0.2"},
    "policy_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policy"}
    },
    "backend_fixtures": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/backendFixture"}
    },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "budget", "max_action", "cash", "allowed_destinations", "allowed_actions", "budget_semantics"],
      "properties": {
        "id": {"type": "string", "pattern": "^policy\\."},
        "budget": {"type": "integer", "minimum": 0},
        "max_action": {"type": "integer", "minimum": 0},
        "cash": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "allowed_destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "budget_semantics": {"const": "gross_debit"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker", "text", "locator"],
      "properties": {
        "id": {"type": "string", "pattern": "^span\\."},
        "speaker": {"enum": ["user", "agent", "policy", "system"]},
        "text": {"type": "string", "minLength": 1},
        "locator": {"const": "exact_quote"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "actor", "source_span_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^action\\."},
        "kind": {"type": "string"},
        "actor": {"type": "string"},
        "amount": {"type": ["integer", "null"]},
        "from": {"type": ["string", "null"]},
        "to": {"type": ["string", "null"]},
        "guard": {"type": ["string", "null"]},
        "effects": {"type": "array", "items": {"type": "string"}},
        "source_span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "formula_label"],
      "properties": {
        "id": {"type": "string", "pattern": "^property\\."},
        "kind": {"enum": ["invariant", "action_constraint", "trace", "liveness"]},
        "formula_label": {"type": "string", "minLength": 1},
        "finding_code": {"type": ["string", "null"]},
        "source_span_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "fsir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "control", "symbol_ids", "state_ids", "actions", "properties", "assumption_ids", "unresolved", "oracle_assertions"],
      "properties": {
        "intent": {"enum": ["action_plan", "no_action", "underspecified_action"]},
        "control": {"enum": ["none", "sequence", "choice", "parallel", "partial_order", "unresolved"]},
        "symbol_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}},
        "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "blocking", "question", "affected_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^unresolved\\."},
              "blocking": {"type": "boolean"},
              "question": {"type": "string", "minLength": 1},
              "affected_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        },
        "oracle_assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_actions", "retry_limit", "time_horizon", "amount_domain"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 0},
        "max_actions": {"type": "integer", "minimum": 0},
        "retry_limit": {"type": "integer", "minimum": 0},
        "time_horizon": {"type": "integer", "minimum": 0},
        "amount_domain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps", "semantic_event_ids", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^trace\\."},
        "steps": {"type": "array", "items": {"type": "string"}},
        "semantic_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^(action|event)\\."}},
        "expect": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "property_ids", "shortest_counterexample", "explanation"],
      "properties": {
        "verdict": {"enum": ["pass", "fail", "needs_clarification", "inconclusive"]},
        "property_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "shortest_counterexample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists", "steps"],
          "properties": {
            "exists": {"type": "boolean"},
            "steps": {"type": "array", "items": {"type": "string"}}
          }
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "nextStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "requires_human_approval"],
      "properties": {
        "kind": {"enum": ["approve", "clarify", "revise_plan", "stop", "retry_tool", "inspect_evidence"]},
        "text": {"type": "string", "minLength": 1},
        "requires_human_approval": {"type": "boolean"}
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edit", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^mutant\\."},
        "edit": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "backendFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "frozen_commit", "source_constructor", "control_kind",
        "module_name", "artifact_directory", "fsir_document", "expected_tlc_verdict",
        "expected_property_ids", "expected_manifest",
        "execution_evidence_manifest", "expected_normalized_event_ids",
        "source_map_direction"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^fixture\\.phase3a\\."},
        "frozen_commit": {"const": "d45efd09ffe5c77b89fcad1954d7959e54b7b8f3"},
        "source_constructor": {"type": "string"},
        "control_kind": {"enum": ["sequence", "partial_order"]},
        "module_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "artifact_directory": {
          "type": "string",
          "pattern": "^backend-artifacts/(ordered|concurrent)$"
        },
        "fsir_document": {"type": "object"},
        "expected_tlc_verdict": {"enum": ["passed", "property_violation"]},
        "expected_property_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^property\\."}
        },
        "expected_manifest": {
          "type": "object",
          "required": ["schema_version", "fsir_document_id", "module_name", "hash_algorithm", "inputs", "outputs", "tools"],
          "properties": {
            "schema_version": {"const": "fsir-tla-manifest-0.1"},
            "hash_algorithm": {"const": "sha256"}
          }
        },
        "execution_evidence_manifest": {
          "type": "object",
          "required": ["schema_version", "module_name", "hash_algorithm", "artifacts"],
          "properties": {
            "schema_version": {"const": "fsir-tla-execution-evidence-0.1"},
            "hash_algorithm": {"const": "sha256"}
          }
        },
        "expected_normalized_event_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(action|event)\\."}
        },
        "source_map_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states", "operators", "properties", "branches"],
          "properties": {
            "states": {"const": "fsir_state_id_to_generated_entry"},
            "operators": {"const": "generated_operator_to_fsir_action_and_optional_outcome"},
            "properties": {"const": "generated_property_to_fsir_property"},
            "branches": {"const": "generated_branch_to_fsir_branch"}
          }
        }
      }
    },
    "loweringOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_commit", "expectation", "reason_code", "emits_artifacts",
        "fixture_id", "expected_rejection", "semantic_action_map",
        "semantic_property_map"
      ],
      "properties": {
        "frozen_commit": {"const": "d45efd09ffe5c77b89fcad1954d7959e54b7b8f3"},
        "expectation": {"enum": ["lower", "reject_blocking", "unsupported"]},
        "reason_code": {
          "enum": [
            "frozen_lifecycle_fixture",
            "blocking_unresolved",
            "requires_exact_fsir_materialization",
            "unsupported_choice_topology",
            "unsupported_retry_or_time_semantics",
            "unsupported_repeated_action_semantics",
            "unsupported_parallel_control"
          ]
        },
        "emits_artifacts": {"type": "boolean"},
        "fixture_id": {"type": ["string", "null"], "pattern": "^fixture\\.phase3a\\."},
        "semantic_action_map": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^(action|event)\\."}
          }
        },
        "semantic_property_map": {
          "type": ["object", "null"],
          "additionalProperties": {"type": "string", "pattern": "^property\\."}
        },
        "expected_rejection": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "message_contains"],
              "properties": {
                "class": {"type": "string"},
                "message_contains": {"type": "string"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"expectation": {"const": "lower"}}},
          "then": {
            "properties": {
              "emits_artifacts": {"const": true},
              "fixture_id": {"type": "string"},
              "expected_rejection": {"type": "null"},
              "semantic_action_map": {"type": "object"},
              "semantic_property_map": {"type": "object"}
            }
          },
          "else": {
            "properties": {
              "emits_artifacts": {"const": false},
              "fixture_id": {"type": "null"},
              "expected_rejection": {"type": "object"},
              "semantic_action_map": {"type": "null"},
              "semantic_property_map": {"type": "null"}
            }
          }
        }
      ]
    },
    "productProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "title", "user_goal", "agent_goal", "agent_phase",
        "source_text", "questions", "fsir_version", "fsir_status",
        "assumptions", "bounds", "nodes", "properties", "verification",
        "findings", "counterexample", "revision", "agent_next_step",
        "approval_scope", "controls", "activity"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^core\\."},
        "title": {"type": "string", "minLength": 1},
        "user_goal": {"type": "string", "minLength": 1},
        "agent_goal": {"type": "string", "minLength": 1},
        "agent_phase": {
          "enum": [
            "clarification_required", "ready_for_review",
            "verification_running", "violation_found",
            "verification_unavailable", "revision_proposed",
            "reverification_required", "checks_passed",
            "bounded_approval_required", "stopped"
          ]
        },
        "source_text": {"type": "string", "minLength": 1},
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "required", "source_span"],
            "properties": {
              "id": {"type": "string"},
              "prompt": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "source_span": {"type": "string", "pattern": "^span\\."}
            }
          }
        },
        "fsir_version": {"type": "string", "pattern": "^fsir\\.core\\."},
        "fsir_status": {"enum": ["clarification_required", "verified_violation", "verified", "inconclusive"]},
        "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount_precision", "max_actions", "accounts", "choices"],
          "properties": {
            "currency": {"const": "USD"},
            "amount_precision": {"const": 2},
            "max_actions": {"type": "integer", "minimum": 0},
            "accounts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "choices": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "label", "fields", "source_spans", "review_status"],
            "properties": {
              "id": {"type": "string", "pattern": "^(action|event)\\."},
              "type": {"type": "string"},
              "label": {"type": "string"},
              "fields": {"type": "object"},
              "source_spans": {"type": "array", "items": {"type": "string", "pattern": "^span\\."}},
              "review_status": {"enum": ["blocked", "reviewed"]}
            }
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "backend", "status"],
            "properties": {
              "id": {"type": "string", "pattern": "^property\\."},
              "label": {"type": "string"},
              "backend": {"enum": ["python-policy+tlc", "tlc"]},
              "status": {"enum": ["passed", "violated", "blocked", "inconclusive"]}
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "backend", "config_hash", "model_hash", "reason_code", "message"],
          "properties": {
            "status": {"enum": ["blocked", "complete", "violation_found", "inconclusive"]},
            "backend": {"enum": ["tlc", "model-only"]},
            "config_hash": {"type": "string"},
            "model_hash": {"type": "string"},
            "reason_code": {
              "type": ["string", "null"],
              "enum": [
                null, "backend_unavailable", "timeout", "bound_exhausted",
                "missing_assumption", "unsupported_property", "model_only"
              ]
            },
            "message": {"type": ["string", "null"]}
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "property_id", "severity", "message", "node_id", "state_id", "expected", "actual"],
            "properties": {
              "code": {"type": "string"},
              "property_id": {"type": "string", "pattern": "^property\\."},
              "severity": {"enum": ["error", "warning", "info"]},
              "message": {"type": "string"},
              "node_id": {"type": ["string", "null"]},
              "state_id": {"type": ["string", "null"]},
              "expected": {"type": "string"},
              "actual": {"type": "string"}
            }
          }
        },
        "counterexample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "first_violating_state", "path"],
          "properties": {
            "summary": {"type": "string"},
            "first_violating_state": {"type": ["string", "null"]},
            "path": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state_id", "action_node_id", "label", "balances", "violations"],
                "properties": {
                  "state_id": {"type": "string", "pattern": "^trace-state\\."},
                  "action_node_id": {"type": ["string", "null"]},
                  "label": {"type": "string"},
                  "balances": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"type": "integer"}
                  },
                  "violations": {"type": "array", "items": {"type": "string", "pattern": "^property\\."}}
                }
              }
            }
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_version", "to_version", "rationale", "diff"],
          "properties": {
            "from_version": {"type": "string"},
            "to_version": {"type": "string"},
            "rationale": {"type": "string"},
            "diff": {"type": "array", "items": {"type": "string"}}
          }
        },
        "agent_next_step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "reason", "requires_approval"],
          "properties": {
            "label": {"type": "string"},
            "reason": {"type": "string"},
            "requires_approval": {"type": "boolean"}
          }
        },
        "approval_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actions", "limits", "expires_at"],
          "properties": {
            "actions": {"type": "array", "items": {"type": "string", "pattern": "^(action|event)\\."}},
            "limits": {"type": "object"},
            "expires_at": {"type": "string"}
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approve", "edit", "reject", "stop", "revise", "rerun",
            "clarify", "inspect_evidence", "resume", "new_goal", "verify"
          ],
          "properties": {
            "approve": {"type": "boolean"},
            "edit": {"type": "boolean"},
            "reject": {"type": "boolean"},
            "stop": {"type": "boolean"},
            "revise": {"type": "boolean"},
            "rerun": {"type": "boolean"},
            "clarify": {"type": "boolean"},
            "inspect_evidence": {"type": "boolean"},
            "resume": {"type": "boolean"},
            "new_goal": {"type": "boolean"},
            "verify": {"type": "boolean"}
          }
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "event", "timestamp", "artifact_hash"],
            "properties": {
              "actor": {"type": "string"},
              "event": {"type": "string"},
              "timestamp": {"type": "string", "format": "date-time"},
              "artifact_hash": {"type": "string"}
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "tags", "policy_profile_id", "prose", "source_spans", "expected_semantics", "bounds", "evidence", "agent_next_step", "positive_traces", "negative_traces", "replay_oracles", "mutants", "lowering_oracle", "product_projection"],
      "properties": {
        "id": {"type": "string", "pattern": "^core\\.[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "level": {"enum": ["L0", "L1", "L2", "L3"]},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "policy_profile_id": {"type": "string", "pattern": "^policy\\."},
        "prose": {"type": "string", "minLength": 1},
        "source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "expected_semantics": {"$ref": "#/$defs/fsir"},
        "bounds": {"$ref": "#/$defs/bounds"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "agent_next_step": {"$ref": "#/$defs/nextStep"},
        "positive_traces": {"type": "array", "items": {"$ref": "#/$defs/trace"}},
        "negative_traces": {"type": "array", "items": {"$ref": "#/$defs/trace"}},
        "replay_oracles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "mutants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutant"}},
        "lowering_oracle": {"$ref": "#/$defs/loweringOracle"},
        "product_projection": {"$ref": "#/$defs/productProjection"},
        "hero_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "state", "label", "required_output", "projection_snapshot"],
            "properties": {
              "stage": {"type": "integer", "minimum": 1},
              "state": {"type": "string"},
              "label": {"type": "string"},
              "required_output": {"type": "string"},
              "projection_snapshot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fsir_version", "fsir_status", "review_status",
                  "verification_status", "config_hash", "model_hash",
                  "evidence_status", "counterexample", "revision", "controls",
                  "activity_event", "approval_scope", "contract_hash"
                ],
                "properties": {
                  "fsir_version": {"type": "string"},
                  "fsir_status": {
                    "enum": [
                      "clarification_required", "review_required",
                      "approved_for_verification", "verified_violation",
                      "revision_proposed", "reverification_required", "verified"
                    ]
                  },
                  "review_status": {"enum": ["blocked", "pending", "approved"]},
                  "verification_status": {"enum": ["blocked", "running", "violation_found", "complete"]},
                  "config_hash": {"type": ["string", "null"]},
                  "model_hash": {"type": ["string", "null"]},
                  "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "evidence_status": {"enum": ["none", "pending", "current", "stale", "fresh"]},
                  "stale_evidence": {"type": "object"},
                  "counterexample": {"type": ["object", "null"]},
                  "revision": {"type": ["object", "null"]},
                  "controls": {"$ref": "#/$defs/productProjection/properties/controls"},
                  "activity_event": {"type": "string"},
                  "approval_scope": {"type": ["object", "null"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
